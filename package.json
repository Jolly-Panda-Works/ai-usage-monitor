{
  "name": "ai-usage-monitor",
  "version": "1.3.0",
  "description": "AI Usage Monitor - Claude / ChatGPT / Gemini / Figma",
  "main": "src/main.js",
  "author": {
    "name": "Usef Farahmand",
    "url": "https://useffarahmand.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.usef.aiusagemonitor",
    "productName": "AI Usage Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/logo.png",
      "assets/logo.svg",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AI-Usage-Monitor-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "AI-Usage-Monitor-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jolly-Panda-Works",
        "repo": "ai-usage-monitor"
      }
    ]
  },
  "homepage": "https://github.com/Jolly-Panda-Works/ai-usage-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jolly-Panda-Works/ai-usage-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Jolly-Panda-Works/ai-usage-monitor/issues"
  },
  "keywords": [
    "ai",
    "usage",
    "tokens",
    "claude",
    "chatgpt",
    "gemini",
    "figma",
    "electron",
    "windows",
    "monitor"
  ],
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
