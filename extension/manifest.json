{
  "manifest_version": 3,
  "name": "AI Usage Monitor",
  "version": "1.5.0",
  "description": "Claude and ChatGPT usage and reset times in your browser, optionally synced to the AI Usage Monitor desktop app on your PC.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Usage Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/Jolly-Panda-Works/ai-usage-monitor",
  "minimum_chrome_version": "116"
}
